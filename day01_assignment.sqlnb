      \    IT_PROG      \r

      \    MK_MAN       \r

      \    MK_REP       \r

      \    PR_REP       \r

      \    PU_CLERK     \r

      \    PU_MAN       \r

      \    SA_MAN       \r

      \    SA_REP       \r

      \    SH_CLERK     \r

      \    ST_CLERK     \r

      \    ST_MAN       \r

      \r

      \    Elapsed: 00:00:00.009\r

      \    19 rows selected. \r

      \r\n"
    languageId: markdown
  - kind: 2
    value: "-- 2. Show `commission_pct` and `salary` for the first 10 rows (use
      `FETCH FIRST 10 ROWS ONLY` or equivalent).\r

      SELECT commission_pct, salary\r

      FROM hr.employees\r

      FETCH FIRST 10 ROWS ONLY;"
